{
  "name": "@respectify/astro",
  "version": "1.0.0",
  "description": "Respectify-powered commenting for Astro \u2014 AI moderation, spam filtering, and beautiful UX out of the box.",
  "type": "module",
  "license": "MIT",
  "author": "Respectify",
  "homepage": "https://www.npmjs.com/package/@respectify/astro",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Respectify/respectify-astro-integration.git"
  },
  "bugs": {
    "url": "https://github.com/Respectify/respectify-astro-integration/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "astro",
    "astro-integration",
    "astro-component",
    "withastro",
    "utility",
    "comments",
    "respectify",
    "moderation",
    "ai"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./actions": "./src/actions.ts",
    "./credentials": "./src/credentials.ts",
    "./routes/comments": "./src/routes/comments.ts",
    "./components/CommentSection.astro": "./components/CommentSection.astro",
    "./components/PoweredByRespectify.astro": "./components/PoweredByRespectify.astro",
    "./client": "./client/comments.ts",
    "./styles.css": "./components/respectify-comments.css",
    "./postgres": "./src/adapters/postgres/index.ts",
    "./sqlite": "./src/adapters/sqlite/index.ts",
    "./testing": "./src/testing/index.ts"
  },
  "files": [
    "src",
    "components",
    "client",
    "migrations",
    "drizzle",
    "default-respectify.config.json",
    "respectify.config.sample.jsonc",
    "README.md"
  ],
  "peerDependencies": {
    "@libsql/client": ">=0.10.0",
    "@respectify/client": "^0.7.0",
    "astro": "^5.0.0 || ^6.0.0 || ^7.0.0",
    "drizzle-orm": "^0.45.0",
    "pg": "^8.0.0",
    "vitest": "^3.0.0",
    "zod": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "@libsql/client": {
      "optional": true
    },
    "drizzle-orm": {
      "optional": true
    },
    "pg": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "dependencies": {
    "zod": "^3.24.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "migrations:generate": "drizzle-kit generate --config drizzle/postgres.config.ts && drizzle-kit generate --config drizzle/sqlite.config.ts"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@libsql/client": "^0.18.0",
    "@respectify/client": "^0.7.0",
    "astro": "^6.0.4",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "typescript": "^5.4.3",
    "vitest": "^3.2.4"
  }
}
